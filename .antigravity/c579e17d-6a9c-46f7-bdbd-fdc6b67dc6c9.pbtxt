      replacement_content: "import {\n  HouseholdProfile,\n  FreelanceProject,\n  BankDebt,\n  SavingsTarget,\n  HouseholdExpense,\n  WindfallSplitRule\n} from \'../types\';\n\nexport const DEFAULT_PROFILE: HouseholdProfile = {\n  currencySymbol: \'$\',\n  currencyCode: \'USD\',\n  husbandName: \'Alex (Videographer)\',\n  wifeName: \'Elena (IT Support)\',\n  wifeMonthlySalary: 3200.0,\n  husbandEstMonthlyGross: 5800.0,\n  emergencyFundMonthsGoal: 6\n};\n\nexport const DEFAULT_SPLIT_RULE: WindfallSplitRule = {\n  debtPayoffPercent: 35,\n  savingsTargetPercent: 35,\n  businessTaxReservePercent: 15,\n  safePocketPercent: 15\n};\n\nexport const DEFAULT_PROJECTS: FreelanceProject[] = [\n  {\n    id: \'proj-1\',\n    clientName: \'Apex Media Agency\',\n    projectTitle: \'Commercial 4K Brand Film\',\n    category: \'COMMERCIAL\',\n    totalFee: 4500.0,\n    depositReceived: 2000.0,\n    invoiceNumber: \'INV-2026-081\',\n    dueDate: \'Next Friday\',\n    status: \'INVOICED\',\n    clientPhone: \'+1 (555) 234-8901\',\n    clientEmail: \'accounts@apexagency.media\',\n    notes: \'Color grading delivered. Waiting on final signoff & balance check of $2,500.\'\n  },\n  {\n    id: \'proj-2\',\n    clientName: \'David & Sarah Wedding\',\n    projectTitle: \'Cinematic Wedding Highlight Video\',\n    category: \'EVENT_WEDDING\',\n    totalFee: 3400.0,\n    depositReceived: 1700.0,\n    invoiceNumber: \'INV-2026-079\',\n    dueDate: \'End of Month\',\n    status: \'INVOICED\',\n    clientPhone: \'+1 (555) 891-2345\',\n    clientEmail: \'sarah.d.wedding@gmail.com\',\n    notes: \'Full ceremony & drone cuts sent. Final $1,700 due upon flash drive handover.\'\n  },\n  {\n    id: \'proj-3\',\n    clientName: \'TechSummit Global\',\n    projectTitle: \'3-Day Keynote & Speaker Recaps\',\n    category: \'CORPORATE\',\n    totalFee: 2800.0,\n    depositReceived: 0.0,\n    invoiceNumber: \'INV-2026-068\',\n    dueDate: \'Past Due (12 days)\',\n    status: \'OVERDUE\',\n    clientPhone: \'+1 (555) 443-1290\',\n    clientEmail: \'finance@techsummit.org\',\n    notes: \'Payment terms were Net-15. Needs active WhatsApp & email collection reminder!\'\n  },\n  {\n    id: \'proj-4\',\n    clientName: \'Horizon Luxury Resort\',\n    projectTitle: \'Summer Promo Social Reels (6x)\',\n    category: \'COMMERCIAL\',\n    totalFee: 2100.0,\n    depositReceived: 1050.0,\n    invoiceNumber: \'INV-2026-085\',\n    dueDate: \'In 2 Weeks\',\n    status: \'IN_PROGRESS\',\n    clientPhone: \'+1 (555) 302-1188\',\n    clientEmail: \'marketing@horizonresort.com\',\n    notes: \'Shooting finished. Rough cuts in review.\'\n  },\n  {\n    id: \'proj-5\',\n    clientName: \'Velvet Fashion Label\',\n    projectTitle: \'Autumn Lookbook Teaser\',\n    category: \'COMMERCIAL\',\n    totalFee: 2200.0,\n    depositReceived: 2200.0,\n    invoiceNumber: \'INV-2026-072\',\n    dueDate: \'Paid\',\n    status: \'COLLECTED\',\n    clientPhone: \'+1 (555) 778-9922\',\n    clientEmail: \'producer@velvetlabel.co\',\n    notes: \'Fully settled via bank wire transfer.\'\n  }\n];\n\nexport const DEFAULT_DEBTS: BankDebt[] = [\n  {\n    id: \'debt-1\',\n    bankName: \'Chase Platinum Credit Card\',\n    debtType: \'CREDIT_CARD\',\n    currentBalance: 4800.0,\n    originalBalance: 6500.0,\n    interestRateApr: 22.4,\n    minMonthlyPayment: 150.0,\n    targetMonthlyPayment: 600.0,\n    dueDayOfMonth: 18,\n    notes: \'Highest APR! First target for Freelance Windfall snowball/avalanche paydown.\'\n  },\n  {\n    id: \'debt-2\',\n    bankName: \'Citibank Equipment Loan\',\n    debtType: \'EQUIPMENT_LOAN\',\n    currentBalance: 7200.0,\n    originalBalance: 10000.0,\n    interestRateApr: 8.9,\n    minMonthlyPayment: 290.0,\n    targetMonthlyPayment: 450.0,\n    dueDayOfMonth: 5,\n    notes: \'Camera rig & lighting equipment financing.\'\n  },\n  {\n    id: \'debt-3\',\n    bankName: \'Bank Overdraft Facility\',\n    debtType: \'OVERDRAFT\',\n    currentBalance: 1250.0,\n    originalBalance: 2500.0,\n    interestRateApr: 15.5,\n    minMonthlyPayment: 100.0,\n    targetMonthlyPayment: 300.0,\n    dueDayOfMonth: 25,\n    notes: \'Emergency credit line used during slow winter season.\'\n  }\n];\n\nexport const DEFAULT_TARGETS: SavingsTarget[] = [\n  {\n    id: \'target-1\',\n    title: \'House Downpayment Vault\',\n    targetAmount: 35000.0,\n    currentSavedAmount: 9200.0,\n    priority: \'CRITICAL\',\n    category: \'Family Home\',\n    deadline: \'Dec 2027\',\n    iconName: \'home\'\n  },\n  {\n    id: \'target-2\',\n    title: \'6-Month Family Emergency Vault\',\n    targetAmount: 16500.0,\n    currentSavedAmount: 4500.0,\n    priority: \'CRITICAL\',\n    category: \'Safety Buffer\',\n    deadline: \'June 2027\',\n    iconName: \'shield\'\n  },\n  {\n    id: \'target-3\',\n    title: \'Sony FX3 Cinema Camera + GM Lenses\',\n    targetAmount: 5500.0,\n    currentSavedAmount: 2400.0,\n    priority: \'MEDIUM\',\n    category: \'Freelance Gear\',\n    deadline: \'Nov 2026\',\n    iconName: \'camera\'\n  },\n  {\n    id: \'target-4\',\n    title: \'Family Annual Summer Holiday\',\n    targetAmount: 3000.0,\n    currentSavedAmount: 1350.0,\n    priority: \'FLEXIBLE\',\n    category: \'Lifestyle & Family\',\n    deadline: \'Aug 2027\',\n    iconName: \'airplane\'\n  }\n];\n\nexport const DEFAULT_EXPENSES: HouseholdExpense[] = [\n  {\n    id: \'exp-1\',\n    title: \'Apartment Rent\',\n    amount: 1400.0,\n    category: \'HOUSING\',\n    isFixed: true,\n    assignedPayer: \'WIFE_SALARY\'\n  },\n  {\n    id: \'exp-2\',\n    title: \'Family Groceries & Supermarket\',\n    amount: 650.0,\n    category: \'GROCERIES\',\n    isFixed: true,\n    assignedPayer: \'WIFE_SALARY\'\n  },\n  {\n    id: \'exp-3\',\n    title: \'Electricity, Water & Gas\',\n    amount: 190.0,\n    category: \'UTILITIES\',\n    isFixed: true,\n    assignedPayer: \'WIFE_SALARY\'\n  },\n  {\n    id: \'exp-4\',\n    title: \'High-Speed Fiber & 2x Mobiles\',\n    amount: 130.0,\n    category: \'INTERNET_PHONE\',\n    isFixed: true,\n    assignedPayer: \'WIFE_SALARY\'\n  },\n  {\n    id: \'exp-5\',\n    title: \'Health Insurance & Medical\',\n    amount: 260.0,\n    category: \'HEALTH\',\n    isFixed: true,\n    assignedPayer: \'WIFE_SALARY\'\n  },\n  {\n    id: \'exp-6\',\n    title: \'Car Fuel & Transportation\',\n    amount: 180.0,\n    category: \'TRANSPORT\',\n    isFixed: true,\n    assignedPayer: \'WIFE_SALARY\'\n  },\n  {\n    id: \'exp-7\',\n    title: \'Adobe Creative Cloud & Cloud Storage\',\n    amount: 85.0,\n    category: \'VIDEO_SOFTWARE\',\n    isFixed: true,\n    assignedPayer: \'FREELANCE_BUFFER\'\n  },\n  {\n    id: \'exp-8\',\n    title: \'Weekend Family Dining & Kids Fun\',\n    amount: 250.0,\n    category: \'FAMILY_LEISURE\',\n    isFixed: false,\n    assignedPayer: \'FREELANCE_BUFFER\'\n  }\n];\n"
