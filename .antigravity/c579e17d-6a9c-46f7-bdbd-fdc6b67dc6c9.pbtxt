    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { Navbar, TabType } from \'./components/Navbar\';\nimport { DashboardView } from \'./components/DashboardView\';\nimport { FreelanceCollectorView } from \'./components/FreelanceCollectorView\';\nimport { HouseholdBudgetView } from \'./components/HouseholdBudgetView\';\nimport { BankDebtView } from \'./components/BankDebtView\';\nimport { SavingsTargetsView } from \'./components/SavingsTargetsView\';\nimport { AiAdvisorView } from \'./components/AiAdvisorView\';\nimport { CollectPaymentModal } from \'./components/CollectPaymentModal\';\nimport { SettingsShareModal } from \'./components/SettingsShareModal\';\nimport { ProjectFormModal } from \'./components/ProjectFormModal\';\nimport { DebtFormModal } from \'./components/DebtFormModal\';\nimport { TargetFormModal } from \'./components/TargetFormModal\';\nimport { ExpenseFormModal } from \'./components/ExpenseFormModal\';\n\nimport {\n  loadProfile,\n  saveProfile,\n  loadProjects,\n  saveProjects,\n  loadDebts,\n  saveDebts,\n  loadTargets,\n  saveTargets,\n  loadExpenses,\n  saveExpenses,\n  loadSplitRule,\n  saveSplitRule,\n  resetAllToDefaults,\n  exportBackupJson,\n  importBackupJson\n} from \'./data/storage\';\nimport {\n  HouseholdProfile,\n  FreelanceProject,\n  BankDebt,\n  SavingsTarget,\n  HouseholdExpense,\n  WindfallSplitRule\n} from \'./types\';\n\nexport const App: React.FC = () => {\n  const [currentTab, setCurrentTab] = useState<TabType>(\'dashboard\');\n\n  // Core Data States\n  const [profile, setProfile] = useState<HouseholdProfile>(loadProfile);\n  const [projects, setProjects] = useState<FreelanceProject[]>(loadProjects);\n  const [debts, setDebts] = useState<BankDebt[]>(loadDebts);\n  const [targets, setTargets] = useState<SavingsTarget[]>(loadTargets);\n  const [expenses, setExpenses] = useState<HouseholdExpense[]>(loadExpenses);\n  const [splitRule, setSplitRule] = useState<WindfallSplitRule>(loadSplitRule);\n\n  // Modals state\n  const [collectProject, setCollectProject] = useState<FreelanceProject | null>(null);\n  const [isSettingsOpen, setIsSettingsOpen] = useState<boolean>(false);\n  const [editingProject, setEditingProject] = useState<FreelanceProject | null | undefined>(undefined);\n  const [editingDebt, setEditingDebt] = useState<BankDebt | null | undefined>(undefined);\n  const [editingTarget, setEditingTarget] = useState<SavingsTarget | null | undefined>(undefined);\n  const [editingExpense, setEditingExpense] = useState<HouseholdExpense | null | undefined>(undefined);\n\n  // Synchronize state with LocalStorage\n  useEffect(() => {\n    saveProfile(profile);\n  }, [profile]);\n\n  useEffect(() => {\n    saveProjects(projects);\n  }, [projects]);\n\n  useEffect(() => {\n    saveDebts(debts);\n  }, [debts]);\n\n  useEffect(() => {\n    saveTargets(targets);\n  }, [targets]);\n\n  useEffect(() => {\n    saveExpenses(expenses);\n  }, [expenses]);\n\n  useEffect(() => {\n    saveSplitRule(splitRule);\n  }, [splitRule]);\n\n  // Project handlers\n  const handleSaveProject = (project: FreelanceProject) => {\n    setProjects((prev) => {\n      const idx = prev.findIndex((p) => p.id === project.id);\n      if (idx >= 0) {\n        const next = [...prev];\n        next[idx] = project;\n        return next;\n      }\n      return [project, ...prev];\n    });\n  };\n\n  const handleDeleteProject = (projectId: string) => {\n    setProjects((prev) => prev.filter((p) => p.id !== projectId));\n  };\n\n  // Debt handlers\n  const handleSaveDebt = (debt: BankDebt) => {\n    setDebts((prev) => {\n      const idx = prev.findIndex((d) => d.id === debt.id);\n      if (idx >= 0) {\n        const next = [...prev];\n        next[idx] = debt;\n        return next;\n      }\n      return [...prev, debt];\n    });\n  };\n\n  const handleDeleteDebt = (debtId: string) => {\n    setDebts((prev) => prev.filter((d) => d.id !== debtId));\n  };\n\n  const handleMakeDebtPayment = (debtId: string, amount: number) => {\n    setDebts((prev) =>\n      prev.map((d) => {\n        if (d.id === debtId) {\n          const newBal = Math.max(0, d.currentBalance - amount);\n          return { ...d, currentBalance: newBal };\n        }\n        return d;\n      })\n    );\n  };\n\n  // Target handlers\n  const handleSaveTarget = (target: SavingsTarget) => {\n    setTargets((prev) => {\n      const idx = prev.findIndex((t) => t.id === target.id);\n      if (idx >= 0) {\n        const next = [...prev];\n        next[idx] = target;\n        return next;\n      }\n      return [...prev, target];\n    });\n  };\n\n  const handleDeleteTarget = (targetId: string) => {\n    setTargets((prev) => prev.filter((t) => t.id !== targetId));\n  };\n\n  const handleDepositToTarget = (targetId: string, amount: number) => {\n    setTargets((prev) =>\n      prev.map((t) => {\n        if (t.id === targetId) {\n          return { ...t, currentSavedAmount: t.currentSavedAmount + amount };\n        }\n        return t;\n      })\n    );\n  };\n\n  // Expense handlers\n  const handleSaveExpense = (expense: HouseholdExpense) => {\n    setExpenses((prev) => {\n      const idx = prev.findIndex((e) => e.id === expense.id);\n      if (idx >= 0) {\n        const next = [...prev];\n        next[idx] = expense;\n        return next;\n      }\n      return [...prev, expense];\n    });\n  };\n\n  const handleDeleteExpense = (expenseId: string) => {\n    setExpenses((prev) => prev.filter((e) => e.id !== expenseId));\n  };\n\n  // Collection & Auto-Split distribution handler\n  const handleConfirmCollection = (\n    projectId: string,\n    collectedAmount: number,\n    splitAllocations: {\n      debtId?: string;\n      debtAmount: number;\n      targetId?: string;\n      targetAmount: number;\n      taxAmount: number;\n      safeAmount: number;\n    }\n  ) => {\n    // 1. Update project deposit & status\n    setProjects((prev) =>\n      prev.map((p) => {\n        if (p.id === projectId) {\n          const newDeposit = Math.min(p.totalFee, p.depositReceived + collectedAmount);\n          const isFullyPaid = newDeposit >= p.totalFee;\n          return {\n            ...p,\n            depositReceived: newDeposit,\n            status: isFullyPaid ? \'COLLECTED\' : p.status\n          };\n        }\n        return p;\n      })\n    );\n\n    // 2. Reduce debt balance if allocated\n    if (splitAllocations.debtId && splitAllocations.debtAmount > 0) {\n      setDebts((prev) =>\n        prev.map((d) => {\n          if (d.id === splitAllocations.debtId) {\n            return {\n              ...d,\n              currentBalance: Math.max(0, d.currentBalance - splitAllocations.debtAmount)\n            };\n          }\n          return d;\n        })\n      );\n    }\n\n    // 3. Increase savings target if allocated\n    if (splitAllocations.targetId && splitAllocations.targetAmount > 0) {\n      setTargets((prev) =>\n        prev.map((t) => {\n          if (t.id === splitAllocations.targetId) {\n            return {\n              ...t,\n              currentSavedAmount: t.currentSavedAmount + splitAllocations.targetAmount\n            };\n          }\n          return t;\n        })\n      );\n    }\n  };\n\n  // Backup & Reset handlers\n  const handleExportJson = () => {\n    const jsonStr = exportBackupJson(profile, projects, debts, targets, expenses, splitRule);\n    const blob = new Blob([jsonStr], { type: \'application/json\' });\n    const url = URL.createObjectURL(blob);\n    const a = document.createElement(\'a\');\n    a.href = url;\n    a.download = `housevault-backup-${new Date().toISOString().slice(0, 10)}.json`;\n    a.click();\n    URL.revokeObjectURL(url);\n  };\n\n  const handleImportJson = (jsonStr: string) => {\n    const res = importBackupJson(jsonStr);\n    if (res.success && res.data) {\n      setProfile(res.data.profile);\n      setProjects(res.data.projects);\n      setDebts(res.data.debts);\n      setTargets(res.data.targets);\n      setExpenses(res.data.expenses);\n      setSplitRule(res.data.splitRule);\n    }\n  };\n\n  const handleResetDefaults = () => {\n    const data = resetAllToDefaults();\n    setProfile(data.profile);\n    setProjects(data.projects);\n    setDebts(data.debts);\n    setTargets(data.targets);\n    setExpenses(data.expenses);\n    setSplitRule(data.splitRule);\n  };\n\n  const uncollectedCount = projects.filter(\n    (p) => p.status !== \'COLLECTED\' && p.totalFee - p.depositReceived > 0\n  ).length;\n  const overdueCount = projects.filter((p) => p.status === \'OVERDUE\').length;\n\n  return (\n    <div className=\"min-h-screen bg-stone-900 text-stone-100 flex flex-col font-sans\">\n      {/* Top Navigation */}\n      <Navbar\n        currentTab={currentTab}\n        onSelectTab={setCurrentTab}\n        profile={profile}\n        onOpenSettings={() => setIsSettingsOpen(true)}\n        uncollectedCount={uncollectedCount}\n        overdueCount={overdueCount}\n      />\n\n      {/* Main View Area */}\n      <main className=\"flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8\">\n        {currentTab === \'dashboard\' && (\n          <DashboardView\n            profile={profile}\n            projects={projects}\n            debts={debts}\n            targets={targets}\n            expenses={expenses}\n            splitRule={splitRule}\n            onNavigate={setCurrentTab}\n            onOpenCollectModal={(p) => setCollectProject(p)}\n            onOpenNewProject={() => setEditingProject(null)}\n            onOpenNewExpense={() => setEditingExpense(null)}\n          />\n        )}\n\n        {currentTab === \'freelance\' && (\n          <FreelanceCollectorView\n            profile={profile}\n            projects={projects}\n            onOpenCollectModal={(p) => setCollectProject(p)}\n            onOpenNewProject={() => setEditingProject(null)}\n            onEditProject={(p) => setEditingProject(p)}\n            onDeleteProject={handleDeleteProject}\n          />\n        )}\n\n        {currentTab === \'budget\' && (\n          <HouseholdBudgetView\n            profile={profile}\n            expenses={expenses}\n            onOpenNewExpense={() => setEditingExpense(null)}\n            onEditExpense={(e) => setEditingExpense(e)}\n            onDeleteExpense={handleDeleteExpense}\n          />\n        )}\n\n        {currentTab === \'debt\' && (\n          <BankDebtView\n            profile={profile}\n            debts={debts}\n            onOpenNewDebt={() => setEditingDebt(null)}\n            onEditDebt={(d) => setEditingDebt(d)}\n            onDeleteDebt={handleDeleteDebt}\n            onMakePayment={handleMakeDebtPayment}\n          />\n        )}\n\n        {currentTab === \'targets\' && (\n          <SavingsTargetsView\n            profile={profile}\n            targets={targets}\n            onOpenNewTarget={() => setEditingTarget(null)}\n            onEditTarget={(t) => setEditingTarget(t)}\n            onDeleteTarget={handleDeleteTarget}\n            onDepositToTarget={handleDepositToTarget}\n          />\n        )}\n\n        {currentTab === \'ai\' && (\n          <AiAdvisorView\n            profile={profile}\n            projects={projects}\n            debts={debts}\n            targets={targets}\n            expenses={expenses}\n          />\n        )}\n      </main>\n\n      {/* Footer */}\n      <footer className=\"border-t border-stone-800/80 py-6 text-center text-xs text-stone-400\">\n        <div className=\"max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-2\">\n          <span>HouseVault \342\200\242 Steady Foundation & Accelerated Wealth Engine</span>\n          <span>{profile.husbandName} & {profile.wifeName}</span>\n        </div>\n      </footer>\n\n      {/* Collect & Auto-Split Modal */}\n      {collectProject && (\n        <CollectPaymentModal\n          project={collectProject}\n          profile={profile}\n          debts={debts}\n          targets={targets}\n          splitRule={splitRule}\n          onClose={() => setCollectProject(null)}\n          onConfirmCollection={handleConfirmCollection}\n        />\n      )}\n\n      {/* Settings & Sync Modal */}\n      {isSettingsOpen && (\n        <SettingsShareModal\n          profile={profile}\n          splitRule={splitRule}\n          onClose={() => setIsSettingsOpen(false)}\n          onSaveProfile={setProfile}\n          onSaveSplitRule={setSplitRule}\n          onExportJson={handleExportJson}\n          onImportJson={handleImportJson}\n          onResetDefaults={handleResetDefaults}\n        />\n      )}\n\n      {/* Project Form Modal */}\n      {editingProject !== undefined && (\n        <ProjectFormModal\n          initialData={editingProject}\n          profile={profile}\n          onClose={() => setEditingProject(undefined)}\n          onSave={handleSaveProject}\n        />\n      )}\n\n      {/* Debt Form Modal */}\n      {editingDebt !== undefined && (\n        <DebtFormModal\n          initialData={editingDebt}\n          profile={profile}\n          onClose={() => setEditingDebt(undefined)}\n          onSave={handleSaveDebt}\n        />\n      )}\n\n      {/* Target Form Modal */}\n      {editingTarget !== undefined && (\n        <TargetFormModal\n          initialData={editingTarget}\n          profile={profile}\n          onClose={() => setEditingTarget(undefined)}\n          onSave={handleSaveTarget}\n        />\n      )}\n\n      {/* Expense Form Modal */}\n      {editingExpense !== undefined && (\n        <ExpenseFormModal\n          initialData={editingExpense}\n          profile={profile}\n          onClose={() => setEditingExpense(undefined)}\n          onSave={handleSaveExpense}\n        />\n      )}\n    </div>\n  );\n};\n"
    }
