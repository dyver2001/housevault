  file_change {
    absolute_path_uri: "file:///app/src/main/java/com/example/ui/screens/MobileShareScreen.kt"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "package com.example.ui.screens\n\nimport android.content.ClipData\nimport android.content.ClipboardManager\nimport android.content.Context\nimport android.content.Intent\nimport android.widget.Toast\nimport androidx.compose.foundation.background\nimport androidx.compose.foundation.layout.*\nimport androidx.compose.foundation.lazy.LazyColumn\nimport androidx.compose.foundation.lazy.LazyRow\nimport androidx.compose.foundation.lazy.items\nimport androidx.compose.foundation.shape.RoundedCornerShape\nimport androidx.compose.material.icons.Icons\nimport androidx.compose.material.icons.filled.*\nimport androidx.compose.material.icons.outlined.*\nimport androidx.compose.material3.*\nimport androidx.compose.runtime.*\nimport androidx.compose.ui.Alignment\nimport androidx.compose.ui.Modifier\nimport androidx.compose.ui.graphics.Color\nimport androidx.compose.ui.platform.LocalContext\nimport androidx.compose.ui.text.font.FontWeight\nimport androidx.compose.ui.unit.dp\nimport androidx.compose.ui.unit.sp\nimport com.example.data.HouseholdProfile\nimport com.example.data.WindfallSplitRule\nimport com.example.ui.components.SectionHeader\nimport com.example.ui.theme.*\nimport com.example.ui.viewmodel.HouseVaultViewModel\n\n@OptIn(ExperimentalMaterial3Api::class)\n@Composable\nfun MobileShareScreen(viewModel: HouseVaultViewModel) {\n    val context = LocalContext.current\n    val profile by viewModel.profile.collectAsState()\n    val splitRule by viewModel.splitRule.collectAsState()\n    val exportJsonText by viewModel.exportJsonText.collectAsState()\n\n    var showExportDialog by remember { mutableStateOf(false) }\n    var showImportDialog by remember { mutableStateOf(false) }\n    var importInputText by remember { mutableStateOf(\"\") }\n    var showProfileDialog by remember { mutableStateOf(false) }\n    var showSplitRuleDialog by remember { mutableStateOf(false) }\n\n    LazyColumn(\n        modifier = Modifier\n            .fillMaxSize()\n            .padding(horizontal = 16.dp),\n        contentPadding = PaddingValues(top = 16.dp, bottom = 90.dp),\n        verticalArrangement = Arrangement.spacedBy(14.dp)\n    ) {\n        item {\n            Text(\n                text = \"APK & iPhone Mobile Setup\",\n                style = MaterialTheme.typography.headlineSmall,\n                fontWeight = FontWeight.ExtraBold\n            )\n            Text(\n                text = \"Run HouseVault on your Android & your wife\'s iPhone\",\n                style = MaterialTheme.typography.bodySmall,\n                color = MaterialTheme.colorScheme.onSurfaceVariant\n            )\n        }\n\n        // --- ANDROID APK GUIDE ---\n        item {\n            Card(\n                modifier = Modifier.fillMaxWidth(),\n                shape = RoundedCornerShape(16.dp),\n                colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface),\n                elevation = CardDefaults.cardElevation(defaultElevation = 2.dp)\n            ) {\n                Column(modifier = Modifier.padding(16.dp)) {\n                    Row(verticalAlignment = Alignment.CenterVertically) {\n                        Surface(\n                            shape = RoundedCornerShape(10.dp),\n                            color = Emerald50\n                        ) {\n                            Icon(\n                                Icons.Default.Android,\n                                contentDescription = null,\n                                tint = Emerald700,\n                                modifier = Modifier\n                                    .padding(8.dp)\n                                    .size(24.dp)\n                            )\n                        }\n                        Spacer(modifier = Modifier.width(12.dp))\n                        Column {\n                            Text(\"Android APK Installation\", fontWeight = FontWeight.Bold, style = MaterialTheme.typography.titleMedium)\n                            Text(\"Native high-performance offline app\", style = MaterialTheme.typography.bodySmall, color = Slate500)\n                        }\n                    }\n\n                    Spacer(modifier = Modifier.height(12.dp))\n\n                    Text(\n                        text = \"1. Export APK from the AI Studio Settings / Deploy menu.\\n2. Tap the downloaded .apk file on your Android device.\\n3. Allow \'Install Unknown Apps\' in Android Settings.\\n4. Enjoy instant offline budgeting & camera gig tracking!\",\n                        style = MaterialTheme.typography.bodySmall,\n                        lineHeight = 20.sp\n                    )\n                }\n            }\n        }\n\n        // --- IPHONE (IOS) SETUP GUIDE ---\n        item {\n            Card(\n                modifier = Modifier.fillMaxWidth(),\n                shape = RoundedCornerShape(16.dp),\n                colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface),\n                elevation = CardDefaults.cardElevation(defaultElevation = 2.dp)\n            ) {\n                Column(modifier = Modifier.padding(16.dp)) {\n                    Row(verticalAlignment = Alignment.CenterVertically) {\n                        Surface(\n                            shape = RoundedCornerShape(10.dp),\n                            color = Color(0xFFF1F5F9)\n                        ) {\n                            Icon(\n                                Icons.Default.PhoneIphone,\n                                contentDescription = null,\n                                tint = Slate800,\n                                modifier = Modifier\n                                    .padding(8.dp)\n                                    .size(24.dp)\n                            )\n                        }\n                        Spacer(modifier = Modifier.width(12.dp))\n                        Column {\n                            Text(\"iPhone Setup for Wife (Elena)\", fontWeight = FontWeight.Bold, style = MaterialTheme.typography.titleMedium)\n                            Text(\"Standalone Home Screen App on iOS\", style = MaterialTheme.typography.bodySmall, color = Slate500)\n                        }\n                    }\n\n                    Spacer(modifier = Modifier.height(12.dp))\n\n                    Text(\n                        text = \"1. Open the App URL in Safari on iPhone.\\n2. Tap the \'Share\' icon (square with arrow pointing up) at the bottom.\\n3. Scroll down and tap \'Add to Home Screen\'.\\n4. HouseVault will install as a standalone full-screen app icon on her iOS home screen!\",\n                        style = MaterialTheme.typography.bodySmall,\n                        lineHeight = 20.sp\n                    )\n                }\n            }\n        }\n\n        // --- DATA SYNC & BACKUP ---\n        item {\n            SectionHeader(\n                title = \"Family Data Sync & Backup\",\n                subtitle = \"Share financial state between husband & wife\"\n            )\n        }\n\n        item {\n            Card(\n                modifier = Modifier.fillMaxWidth(),\n                shape = RoundedCornerShape(16.dp),\n                colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface),\n                elevation = CardDefaults.cardElevation(defaultElevation = 2.dp)\n            ) {\n                Column(modifier = Modifier.padding(16.dp)) {\n                    Row(\n                        modifier = Modifier.fillMaxWidth(),\n                        horizontalArrangement = Arrangement.spacedBy(8.dp)\n                    ) {\n                        Button(\n                            onClick = {\n                                viewModel.exportData()\n                                showExportDialog = true\n                            },\n                            modifier = Modifier.weight(1f),\n                            colors = ButtonDefaults.buttonColors(containerColor = Emerald600),\n                            shape = RoundedCornerShape(10.dp)\n                        ) {\n                            Icon(Icons.Default.Upload, contentDescription = null, modifier = Modifier.size(16.dp))\n                            Spacer(modifier = Modifier.width(4.dp))\n                            Text(\"Export JSON\")\n                        }\n\n                        OutlinedButton(\n                            onClick = { showImportDialog = true },\n                            modifier = Modifier.weight(1f),\n                            shape = RoundedCornerShape(10.dp)\n                        ) {\n                            Icon(Icons.Default.Download, contentDescription = null, modifier = Modifier.size(16.dp))\n                            Spacer(modifier = Modifier.width(4.dp))\n                            Text(\"Import JSON\")\n                        }\n                    }\n\n                    Spacer(modifier = Modifier.height(8.dp))\n\n                    Text(\n                        text = \"Export generates a portable snapshot of all freelance invoices, bank debts, and savings targets to share via WhatsApp or AirDrop.\",\n                        style = MaterialTheme.typography.bodySmall,\n                        color = MaterialTheme.colorScheme.onSurfaceVariant\n                    )\n                }\n            }\n        }\n\n        // --- HOUSEHOLD PROFILE & CURRENCY SETTINGS ---\n        item {\n            SectionHeader(\n                title = \"Household Settings & Currency\",\n                subtitle = \"Salaries, names, and allocation percentage rules\"\n            )\n        }\n\n        item {\n            Card(\n                modifier = Modifier.fillMaxWidth(),\n                shape = RoundedCornerShape(16.dp),\n                colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surface),\n                elevation = CardDefaults.cardElevation(defaultElevation = 2.dp)\n            ) {\n                Column(modifier = Modifier.padding(16.dp)) {\n                    Row(\n                        modifier = Modifier.fillMaxWidth(),\n                        horizontalArrangement = Arrangement.SpaceBetween,\n                        verticalAlignment = Alignment.CenterVertically\n                    ) {\n                        Column {\n                            Text(\"Household Members\", fontWeight = FontWeight.Bold)\n                            Text(\"${profile.husbandName} \342\200\242 ${profile.wifeName}\", style = MaterialTheme.typography.bodySmall, color = Slate500)\n                            Text(\"Wife IT Salary: ${profile.currencySymbol}${profile.wifeMonthlySalary}/mo\", style = MaterialTheme.typography.bodySmall, color = Emerald700, fontWeight = FontWeight.Bold)\n                        }\n\n                        Button(\n                            onClick = { showProfileDialog = true },\n                            colors = ButtonDefaults.buttonColors(containerColor = Slate800),\n                            shape = RoundedCornerShape(10.dp)\n                        ) {\n                            Text(\"Edit\")\n                        }\n                    }\n\n                    Spacer(modifier = Modifier.height(14.dp))\n                    HorizontalDivider(color = Slate200)\n                    Spacer(modifier = Modifier.height(14.dp))\n\n                    Row(\n                        modifier = Modifier.fillMaxWidth(),\n                        horizontalArrangement = Arrangement.SpaceBetween,\n                        verticalAlignment = Alignment.CenterVertically\n                    ) {\n                        Column {\n                            Text(\"Freelance Split Rules\", fontWeight = FontWeight.Bold)\n                            Text(\"Debt: ${splitRule.debtPayoffPercent}% \342\200\242 Savings: ${splitRule.savingsTargetPercent}% \342\200\242 Tax: ${splitRule.businessTaxReservePercent}% \342\200\242 Pocket: ${splitRule.safePocketPercent}%\", style = MaterialTheme.typography.bodySmall, color = Slate500)\n                        }\n\n                        Button(\n                            onClick = { showSplitRuleDialog = true },\n                            colors = ButtonDefaults.buttonColors(containerColor = Slate800),\n                            shape = RoundedCornerShape(10.dp)\n                        ) {\n                            Text(\"Adjust\")\n                        }\n                    }\n\n                    Spacer(modifier = Modifier.height(14.dp))\n                    HorizontalDivider(color = Slate200)\n                    Spacer(modifier = Modifier.height(14.dp))\n\n                    OutlinedButton(\n                        onClick = {\n                            viewModel.resetToDefaults()\n                            Toast.makeText(context, \"Sample data reset to default!\", Toast.LENGTH_SHORT).show()\n                        },\n                        modifier = Modifier.fillMaxWidth(),\n                        colors = ButtonDefaults.outlinedButtonColors(contentColor = Rose600),\n                        shape = RoundedCornerShape(10.dp)\n                    ) {\n                        Icon(Icons.Default.Refresh, contentDescription = null, modifier = Modifier.size(16.dp))\n                        Spacer(modifier = Modifier.width(6.dp))\n                        Text(\"Reset to Sample Household Data\")\n                    }\n                }\n            }\n        }\n    }\n\n    // --- EXPORT DIALOG ---\n    if (showExportDialog && exportJsonText != null) {\n        AlertDialog(\n            onDismissRequest = { showExportDialog = false },\n            title = { Text(\"Export Household Data\", fontWeight = FontWeight.Bold) },\n            text = {\n                Column {\n                    Text(\"Copy this JSON or share directly to your wife\'s phone:\", style = MaterialTheme.typography.bodySmall)\n                    Spacer(modifier = Modifier.height(8.dp))\n                    Card(colors = CardDefaults.cardColors(containerColor = Slate100)) {\n                        Text(\n                            text = exportJsonText?.take(300) + \"...\\n(Total length: ${exportJsonText?.length} chars)\",\n                            style = MaterialTheme.typography.bodySmall,\n                            modifier = Modifier.padding(10.dp)\n                        )\n                    }\n                }\n            },\n            confirmButton = {\n                Button(\n                    onClick = {\n                        val clipboard = context.getSystemService(Context.CLIPBOARD_SERVICE) as ClipboardManager\n                        val clip = ClipData.newPlainText(\"HouseVault Backup\", exportJsonText ?: \"\")\n                        clipboard.setPrimaryClip(clip)\n                        Toast.makeText(context, \"Backup copied to clipboard!\", Toast.LENGTH_SHORT).show()\n\n                        try {\n                            val sendIntent = Intent().apply {\n                                action = Intent.ACTION_SEND\n                                putExtra(Intent.EXTRA_TEXT, exportJsonText)\n                                type = \"text/plain\"\n                            }\n                            context.startActivity(Intent.createChooser(sendIntent, \"Share Backup to Wife\"))\n                        } catch (e: Exception) {\n                            // ignore\n                        }\n                        showExportDialog = false\n                    },\n                    colors = ButtonDefaults.buttonColors(containerColor = Emerald600)\n                ) {\n                    Text(\"Copy & Share\")\n                }\n            },\n            dismissButton = {\n                TextButton(onClick = { showExportDialog = false }) {\n                    Text(\"Close\")\n                }\n            }\n        )\n    }\n\n    // --- IMPORT DIALOG ---\n    if (showImportDialog) {\n        AlertDialog(\n            onDismissRequest = { showImportDialog = false },\n            title = { Text(\"Import Household Data\", fontWeight = FontWeight.Bold) },\n            text = {\n                Column {\n                    Text(\"Paste the JSON backup string below:\", style = MaterialTheme.typography.bodySmall)\n                    Spacer(modifier = Modifier.height(8.dp))\n                    OutlinedTextField(\n                        value = importInputText,\n                        onValueChange = { importInputText = it },\n                        label = { Text(\"JSON Data\") },\n                        modifier = Modifier.fillMaxWidth(),\n                        minLines = 4\n                    )\n                }\n            },\n            confirmButton = {\n                Button(\n                    onClick = {\n                        if (importInputText.isNotBlank()) {\n                            val success = viewModel.importData(importInputText)\n                            if (success) {\n                                Toast.makeText(context, \"Data imported successfully!\", Toast.LENGTH_SHORT).show()\n                            } else {\n                                Toast.makeText(context, \"Invalid JSON format\", Toast.LENGTH_SHORT).show()\n                            }\n                        }\n                        showImportDialog = false\n                    },\n                    colors = ButtonDefaults.buttonColors(containerColor = Emerald600)\n                ) {\n                    Text(\"Import\")\n                }\n            },\n            dismissButton = {\n                TextButton(onClick = { showImportDialog = false }) {\n                    Text(\"Cancel\")\n                }\n            }\n        )\n    }\n\n    // --- EDIT PROFILE DIALOG ---\n    if (showProfileDialog) {\n        var hName by remember { mutableStateOf(profile.husbandName) }\n        var wName by remember { mutableStateOf(profile.wifeName) }\n        var wSalary by remember { mutableStateOf(profile.wifeMonthlySalary.toString()) }\n        var hEstGross by remember { mutableStateOf(profile.husbandEstMonthlyGross.toString()) }\n        var curSymbol by remember { mutableStateOf(profile.currencySymbol) }\n        var curCode by remember { mutableStateOf(profile.currencyCode) }\n\n        val currencyOptions = listOf(\n            Triple(\"$\", \"USD\", \"USD ($)\"),\n            Triple(\"\342\202\254\", \"EUR\", \"EUR (\342\202\254)\"),\n            Triple(\"\302\243\", \"GBP\", \"GBP (\302\243)\"),\n            Triple(\"\330\257.\330\245\", \"AED\", \"AED (\330\257.\330\245)\"),\n            Triple(\"\330\257.\331\203\", \"KWD\", \"KWD (\330\257.\331\203)\"),\n            Triple(\"\357\267\274\", \"SAR\", \"SAR (\357\267\274)\"),\n            Triple(\"L\302\243\", \"LBP\", \"LBP (L\302\243)\"),\n            Triple(\"C$\", \"CAD\", \"CAD (C$)\"),\n            Triple(\"A$\", \"AUD\", \"AUD (A$)\")\n        )\n\n        AlertDialog(\n            onDismissRequest = { showProfileDialog = false },\n            title = { Text(\"Household Profile & Currency\", fontWeight = FontWeight.Bold) },\n            text = {\n                LazyColumn(verticalArrangement = Arrangement.spacedBy(10.dp)) {\n                    item {\n                        Text(\"Select Currency:\", style = MaterialTheme.typography.labelSmall, fontWeight = FontWeight.Bold)\n                        LazyRow(horizontalArrangement = Arrangement.spacedBy(6.dp)) {\n                            items(currencyOptions) { (sym, code, label) ->\n                                FilterChip(\n                                    selected = curSymbol == sym,\n                                    onClick = {\n                                        curSymbol = sym\n                                        curCode = code\n                                    },\n                                    label = { Text(label, fontSize = 11.sp) }\n                                )\n                            }\n                        }\n                    }\n\n                    item {\n                        OutlinedTextField(\n                            value = hName,\n                            onValueChange = { hName = it },\n                            label = { Text(\"Husband Name & Title\") },\n                            modifier = Modifier.fillMaxWidth()\n                        )\n                    }\n\n                    item {\n                        OutlinedTextField(\n                            value = wName,\n                            onValueChange = { wName = it },\n                            label = { Text(\"Wife Name & Title\") },\n                            modifier = Modifier.fillMaxWidth()\n                        )\n                    }\n\n                    item {\n                        OutlinedTextField(\n                            value = wSalary,\n                            onValueChange = { wSalary = it },\n                            label = { Text(\"Wife Monthly IT Salary ($curSymbol)\") },\n                            modifier = Modifier.fillMaxWidth()\n                        )\n                    }\n\n                    item {\n                        OutlinedTextField(\n                            value = hEstGross,\n                            onValueChange = { hEstGross = it },\n                            label = { Text(\"Husband Est. Monthly Freelance Gross ($curSymbol)\") },\n                            modifier = Modifier.fillMaxWidth()\n                        )\n                    }\n                }\n            },\n            confirmButton = {\n                Button(\n                    onClick = {\n                        val sal = wSalary.toDoubleOrNull() ?: profile.wifeMonthlySalary\n                        val gro = hEstGross.toDoubleOrNull() ?: profile.husbandEstMonthlyGross\n                        viewModel.updateProfile(\n                            profile.copy(\n                                husbandName = hName,\n                                wifeName = wName,\n                                wifeMonthlySalary = sal,\n                                husbandEstMonthlyGross = gro,\n                                currencySymbol = curSymbol,\n                                currencyCode = curCode\n                            )\n                        )\n                        showProfileDialog = false\n                    },\n                    colors = ButtonDefaults.buttonColors(containerColor = Emerald600)\n                ) {\n                    Text(\"Save Profile\")\n                }\n            },\n            dismissButton = {\n                TextButton(onClick = { showProfileDialog = false }) {\n                    Text(\"Cancel\")\n                }\n            }\n        )\n    }\n\n    // --- EDIT SPLIT RULE DIALOG ---\n    if (showSplitRuleDialog) {\n        var debtPct by remember { mutableStateOf(splitRule.debtPayoffPercent.toString()) }\n        var savPct by remember { mutableStateOf(splitRule.savingsTargetPercent.toString()) }\n        var taxPct by remember { mutableStateOf(splitRule.businessTaxReservePercent.toString()) }\n        var safePct by remember { mutableStateOf(splitRule.safePocketPercent.toString()) }\n\n        AlertDialog(\n            onDismissRequest = { showSplitRuleDialog = false },\n            title = { Text(\"Freelance Windfall Split %\", fontWeight = FontWeight.Bold) },\n            text = {\n                Column(verticalArrangement = Arrangement.spacedBy(10.dp)) {\n                    Text(\"When a freelance check is collected, split it automatically:\", style = MaterialTheme.typography.bodySmall)\n\n                    OutlinedTextField(\n                        value = debtPct,\n                        onValueChange = { debtPct = it },\n                        label = { Text(\"Bank Debt Payoff %\") },\n                        modifier = Modifier.fillMaxWidth()\n                    )\n\n                    OutlinedTextField(\n                        value = savPct,\n                        onValueChange = { savPct = it },\n                        label = { Text(\"House & Family Savings %\") },\n                        modifier = Modifier.fillMaxWidth()\n                    )\n\n                    OutlinedTextField(\n                        value = taxPct,\n                        onValueChange = { taxPct = it },\n                        label = { Text(\"Tax & Gear Maintenance %\") },\n                        modifier = Modifier.fillMaxWidth()\n                    )\n\n                    OutlinedTextField(\n                        value = safePct,\n                        onValueChange = { safePct = it },\n                        label = { Text(\"Safe-to-Spend Freelance Pocket %\") },\n                        modifier = Modifier.fillMaxWidth()\n                    )\n                }\n            },\n            confirmButton = {\n                Button(\n                    onClick = {\n                        val d = debtPct.toIntOrNull() ?: 35\n                        val s = savPct.toIntOrNull() ?: 35\n                        val t = taxPct.toIntOrNull() ?: 15\n                        val p = safePct.toIntOrNull() ?: 15\n                        viewModel.updateSplitRule(WindfallSplitRule(d, s, t, p))\n                        showSplitRuleDialog = false\n                    },\n                    colors = ButtonDefaults.buttonColors(containerColor = Emerald600)\n                ) {\n                    Text(\"Save Split Rules\")\n                }\n            },\n            dismissButton = {\n                TextButton(onClick = { showSplitRuleDialog = false }) {\n                    Text(\"Cancel\")\n                }\n            }\n        )\n    }\n}\n"
    }
