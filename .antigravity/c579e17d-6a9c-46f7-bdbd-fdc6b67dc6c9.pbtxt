      replacement_content: "import React from \'react\';\nimport {\n  LayoutDashboard,\n  Coins,\n  Receipt,\n  Landmark,\n  Vault,\n  Sparkles,\n  Settings,\n  ShieldCheck\n} from \'lucide-react\';\nimport { HouseholdProfile } from \'../types\';\n\nexport type TabType =\n  | \'dashboard\'\n  | \'freelance\'\n  | \'budget\'\n  | \'debt\'\n  | \'targets\'\n  | \'ai\';\n\ninterface NavbarProps {\n  currentTab: TabType;\n  onSelectTab: (tab: TabType) => void;\n  profile: HouseholdProfile;\n  onOpenSettings: () => void;\n  uncollectedCount: number;\n  overdueCount: number;\n}\n\nexport const Navbar: React.FC<NavbarProps> = ({\n  currentTab,\n  onSelectTab,\n  profile,\n  onOpenSettings,\n  uncollectedCount,\n  overdueCount\n}) => {\n  const tabs = [\n    {\n      id: \'dashboard\' as TabType,\n      label: \'Dashboard\',\n      icon: LayoutDashboard,\n    },\n    {\n      id: \'freelance\' as TabType,\n      label: \'Freelance Collector\',\n      icon: Coins,\n      badge: uncollectedCount > 0 ? uncollectedCount : undefined,\n      badgeAlert: overdueCount > 0\n    },\n    {\n      id: \'budget\' as TabType,\n      label: \'Household Budget\',\n      icon: Receipt,\n    },\n    {\n      id: \'debt\' as TabType,\n      label: \'Bank Debt Snowball\',\n      icon: Landmark,\n    },\n    {\n      id: \'targets\' as TabType,\n      label: \'Savings Vaults\',\n      icon: Vault,\n    },\n    {\n      id: \'ai\' as TabType,\n      label: \'AI Strategist\',\n      icon: Sparkles,\n      highlight: true\n    }\n  ];\n\n  return (\n    <header className=\"sticky top-0 z-40 bg-stone-900/90 backdrop-blur-md border-b border-stone-800\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex items-center justify-between h-16\">\n          {/* Logo & Couple Tag */}\n          <div className=\"flex items-center space-x-3 cursor-pointer\" onClick={() => onSelectTab(\'dashboard\')}>\n            <div className=\"w-10 h-10 rounded-xl bg-gradient-to-br from-amber-500 via-orange-500 to-emerald-600 flex items-center justify-center shadow-lg shadow-amber-500/10\">\n              <ShieldCheck className=\"w-6 h-6 text-stone-950 stroke-[2.5]\" />\n            </div>\n            <div>\n              <div className=\"flex items-center space-x-2\">\n                <span className=\"font-display font-extrabold text-xl tracking-tight text-white\">HouseVault</span>\n                <span className=\"text-xs font-semibold px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20\">\n                  {profile.currencyCode} ({profile.currencySymbol})\n                </span>\n              </div>\n              <p className=\"text-xs text-stone-400 hidden sm:block\">\n                {profile.husbandName} & {profile.wifeName}\n              </p>\n            </div>\n          </div>\n\n          {/* Desktop Navigation Tabs */}\n          <nav className=\"hidden lg:flex items-center space-x-1\">\n            {tabs.map((t) => {\n              const Icon = t.icon;\n              const isActive = currentTab === t.id;\n              return (\n                <button\n                  key={t.id}\n                  id={`nav-tab-${t.id}`}\n                  onClick={() => onSelectTab(t.id)}\n                  className={`relative flex items-center space-x-2 px-3.5 py-2 rounded-xl text-sm font-medium transition-all duration-200 ${\n                    isActive\n                      ? t.highlight\n                        ? \'bg-amber-500/20 text-amber-300 border border-amber-500/30\'\n                        : \'bg-stone-800 text-white shadow-sm border border-stone-700\'\n                      : \'text-stone-400 hover:text-stone-200 hover:bg-stone-800/50\'\n                  }`}\n                >\n                  <Icon className={`w-4 h-4 ${isActive ? (t.highlight ? \'text-amber-400\' : \'text-emerald-400\') : \'text-stone-400\'}`} />\n                  <span>{t.label}</span>\n                  {t.badge !== undefined && (\n                    <span\n                      className={`ml-1.5 px-1.5 py-0.5 text-xs font-bold rounded-full ${\n                        t.badgeAlert\n                          ? \'bg-rose-500 text-white animate-pulse\'\n                          : \'bg-amber-500/20 text-amber-400\'\n                      }`}\n                    >\n                      {t.badge}\n                    </span>\n                  )}\n                </button>\n              );\n            })}\n          </nav>\n\n          {/* Right Action: Settings & Share */}\n          <div className=\"flex items-center space-x-2\">\n            <button\n              id=\"btn-open-settings\"\n              onClick={onOpenSettings}\n              className=\"p-2 rounded-xl text-stone-400 hover:text-white hover:bg-stone-800 transition-colors flex items-center space-x-2 text-sm font-medium border border-transparent hover:border-stone-700\"\n              title=\"Settings, Couple Profile & Backup\"\n            >\n              <Settings className=\"w-5 h-5\" />\n              <span className=\"hidden sm:inline\">Settings & Sync</span>\n            </button>\n          </div>\n        </div>\n\n        {/* Mobile Sub-Navigation Bar */}\n        <div className=\"flex lg:hidden overflow-x-auto py-2 space-x-1.5 border-t border-stone-800/60 no-scrollbar\">\n          {tabs.map((t) => {\n            const Icon = t.icon;\n            const isActive = currentTab === t.id;\n            return (\n              <button\n                key={t.id}\n                id={`mobile-tab-${t.id}`}\n                onClick={() => onSelectTab(t.id)}\n                className={`flex-shrink-0 flex items-center space-x-1.5 px-3 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap transition-colors ${\n                  isActive\n                    ? \'bg-emerald-500/15 text-emerald-300 border border-emerald-500/30\'\n                    : \'text-stone-400 bg-stone-800/40 hover:bg-stone-800\'\n                }`}\n              >\n                <Icon className=\"w-3.5 h-3.5\" />\n                <span>{t.label}</span>\n                {t.badge !== undefined && (\n                  <span className={`px-1 rounded-full text-[10px] ${t.badgeAlert ? \'bg-rose-500 text-white\' : \'bg-stone-700 text-amber-300\'}`}>\n                    {t.badge}\n                  </span>\n                )}\n              </button>\n            );\n          })}\n        </div>\n      </div>\n    </header>\n  );\n};\n"
    }
